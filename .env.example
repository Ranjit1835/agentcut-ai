# ============================================================
# AgentCut AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ----- AI Providers -----
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
GROQ_API_KEY=gsk_your-groq-api-key
OPENAI_API_KEY=sk-your-openai-api-key

# ----- LangSmith Observability -----
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ls__your-langsmith-api-key
LANGCHAIN_PROJECT=agentcut-ai-production

# ----- AWS / Cloudflare R2 -----
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_REGION=auto
R2_BUCKET_NAME=agentcut-uploads
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://cdn.agentcut.ai

# ----- Inngest (Background Jobs) -----
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=signkey-prod-your-signing-key

# ----- Sentry (Error Tracking) -----
SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX
NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX
SENTRY_AUTH_TOKEN=sntrys_your-sentry-auth-token
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=agentcut-ai

# ----- PostHog (Product Analytics) -----
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=phx_your-posthog-personal-api-key

# ----- Polar.sh (Billing) -----
POLAR_ACCESS_TOKEN=polar_at_your-token
POLAR_ORGANIZATION_ID=your-polar-org-id
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret

# ----- Application -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000
NODE_ENV=development

# ----- Backend -----
BACKEND_SECRET_KEY=your-super-secret-backend-key-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,https://agentcut.ai
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres

# ----- Redis (optional, for caching) -----
REDIS_URL=redis://localhost:6379
