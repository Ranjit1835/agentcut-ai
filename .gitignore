# ----- Dependencies -----
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ----- Build outputs -----
.next/
out/
dist/
build/
*.tsbuildinfo

# ----- Environment variables (NEVER commit secrets) -----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.staging
!.env.example

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
ENV/
.env/
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
dist/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
!apps/frontend/lib/
lib64/
wheels/
share/python-wheels/
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
pytestmark.py
__pypackages__/

# ----- IDEs and editors -----
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.project
.classpath
.settings/
*.iml

# ----- Logs -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----- OS -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ----- Testing -----
coverage/
.nyc_output/
junit.xml

# ----- Turbo -----
.turbo/

# ----- Supabase -----
supabase/.branches/
supabase/.temp/

# ----- Docker -----
docker-compose.override.yml

# ----- Local storage (dev only) -----
.local-storage/

# ----- Misc -----
.cache/
.parcel-cache/
*.pem
*.key
*.crt
.vercel
.netlify
